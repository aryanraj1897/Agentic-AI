# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o

# System & Limit Configurations
MAX_FILE_SIZE_MB=50
EXECUTION_TIMEOUT=30
MAX_RETRIES=3

# Server & Security Configurations
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost
LOG_LEVEL=INFO
